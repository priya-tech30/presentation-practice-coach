<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="60dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_record_back"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/pc_text"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Session"
                        android:textColor="@color/pc_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sessionSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Let's make your voice stronger ✨"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_profile_circle"
                    android:gravity="center"
                    android:text="Z"
                    android:textColor="@color/pc_text"
                    android:textStyle="bold"
                    android:textSize="20sp" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="TALK PRACTICE"
                android:textColor="@color/pc_violet_light"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- RECORDING PANEL -->

            <LinearLayout
                android:id="@+id/recordingPanel"
                android:layout_width="match_parent"
                android:layout_height="390dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_recording_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/recordingHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY WHEN YOU ARE"
                    android:textColor="#F0D9FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <!-- WAVEFORM -->

                <LinearLayout
                    android:id="@+id/waveform"
                    android:layout_width="250dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="25dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="42dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="65dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave_active" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="35dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="78dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave_active" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="52dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="88dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave_active" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="40dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="62dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave_active" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="30dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="72dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave_active" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="46dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="26dp"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_wave" />

                </LinearLayout>


                <!-- TIMER -->

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/pc_text"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recordStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tap the microphone to begin"
                    android:textColor="#E3CFF2"
                    android:textSize="14sp" />


                <!-- RECORD BUTTON -->

                <TextView
                    android:id="@+id/recordButton"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_record_button_new"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/pc_text"
                    android:textSize="30sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- TIP -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_tip_card"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="💡"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Tip: Slow down slightly and let your ideas breathe."
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CONTINUE BUTTON -->

            <Button
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="Continue to Analysis  →"
                android:textColor="@color/pc_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_main_cta"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>