<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background">

    <!-- ============================= -->
    <!-- MAIN SCROLLING CONTENT        -->
    <!-- ============================= -->

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="60dp"
            android:paddingEnd="20dp">

            <!-- ============================= -->
            <!-- GREETING                      -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good evening, Zia 💗"
                        android:textColor="@color/pc_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Small practice, big confidence ✨"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Profile shortcut -->
                <TextView
                    android:id="@+id/homeProfileButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_profile_circle"
                    android:gravity="center"
                    android:text="Z"
                    android:textColor="@color/pc_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- ============================= -->
            <!-- HERO                          -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Speak"
                    android:textColor="@color/pc_text"
                    android:textSize="40sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Grow"
                    android:textColor="@color/pc_violet_light"
                    android:textSize="40sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="You"
                        android:textColor="@color/pc_text"
                        android:textSize="40sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="you got this ♡"
                        android:textColor="@color/pc_pink_light"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                </LinearLayout>

            </LinearLayout>


            <!-- ============================= -->
            <!-- LEVEL CARD                    -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/levelCard"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_level_card_new"
                android:orientation="vertical"
                android:padding="17dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/homeLevelText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Level 1 · Beginner"
                        android:textColor="@color/pc_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♛"
                        android:textColor="@color/pc_gold"
                        android:textSize="24sp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/homeXPProgress"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progress="45"
                    android:progressTint="@color/pc_pink_light"
                    android:backgroundTint="#43256B" />

                <TextView
                    android:id="@+id/homeXPText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="45 / 100 XP"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ============================= -->
            <!-- MAIN CTA                      -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/startSessionButton"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_main_cta"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🎙"
                    android:textSize="29sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start New Session"
                        android:textColor="@color/pc_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Practice. Get feedback. Be better."
                        android:textColor="#F3DDFE"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_arrow_circle"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/pc_text"
                    android:textSize="32sp" />

            </LinearLayout>

            <!-- ============================= -->
            <!-- RECENT SESSIONS               -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Sessions"
                    android:textColor="@color/pc_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/seeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textColor="@color/pc_violet_light"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- Recent Session 1 -->

            <LinearLayout
                android:id="@+id/recentSessionOne"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_session_card_new"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_session_icon_new"
                    android:gravity="center"
                    android:text="🎙"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recentSessionOneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Talk Practice"
                        android:textColor="@color/pc_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recentSessionOneDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No sessions yet"
                        android:textColor="@color/pc_text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/recentSessionOneScore"
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_score_mint"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="@color/pc_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Recent Session 2 -->

            <LinearLayout
                android:id="@+id/recentSessionTwo"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_session_card_new"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_session_icon_new"
                    android:gravity="center"
                    android:text="✨"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recentSessionTwoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practice Session"
                        android:textColor="@color/pc_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recentSessionTwoDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your previous practice will appear here"
                        android:textColor="@color/pc_text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/recentSessionTwoScore"
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_score_gold"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="@color/pc_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Bottom breathing space -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ============================= -->
    <!-- BOTTOM NAVIGATION             -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_bottom_nav_new"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- HOME -->

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="@color/pc_pink_light"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- TALK / RECORD -->

        <TextView
            android:id="@+id/navRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●\nTalk"
            android:textColor="@color/pc_text_muted"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- HISTORY -->

        <TextView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◷\nHistory"
            android:textColor="@color/pc_text_muted"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- PROGRESS -->

        <TextView
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↗\nProgress"
            android:textColor="@color/pc_text_muted"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- PROFILE -->

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="@color/pc_text_muted"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>