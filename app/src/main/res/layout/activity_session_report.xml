<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_record_back"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/pc_text"
                android:textSize="32sp"
                android:fontFamily="sans"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION REPORT"
                    android:textColor="@color/pc_violet_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Your speaking snapshot"
                    android:textColor="@color/pc_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_profile_circle"
                android:gravity="center"
                android:text="Z"
                android:textColor="@color/pc_text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- OVERALL SCORE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_level_card_new"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERALL SCORE"
                android:textColor="#EAD9FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/overallScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="78"
                android:textColor="@color/pc_text"
                android:textSize="60sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="out of 100"
                android:textColor="#EAD9FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/scoreMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="You're building confidence ✨"
                android:textColor="@color/pc_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="PERFORMANCE"
            android:textColor="@color/pc_violet_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />


        <!-- PERFORMANCE ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- PACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_mode_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/paceScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="82%"
                    android:textColor="@color/pc_mint"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speaking Pace"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- CLARITY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mode_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="@color/pc_violet_light"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/clarityScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="81%"
                    android:textColor="@color/pc_violet_light"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clarity"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- PERFORMANCE ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- FILLER WORDS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_mode_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◌"
                    android:textColor="@color/pc_gold"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/fillerScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="74%"
                    android:textColor="@color/pc_gold"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filler Control"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- CONFIDENCE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mode_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡"
                    android:textColor="@color/pc_pink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/confidenceScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="76%"
                    android:textColor="@color/pc_pink"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- TRANSCRIPT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="TRANSCRIPT"
            android:textColor="@color/pc_violet_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_session_card_new"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/transcriptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your transcript will appear here after your audio is processed. This is where Whisper will convert your speech into text."
                android:textColor="@color/pc_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- AI FEEDBACK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="AI FEEDBACK"
            android:textColor="@color/pc_violet_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_session_card_new"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/feedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your answer had a clear structure and a confident opening. Try adding a little more detail when explaining your main point."
                android:textColor="@color/pc_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- WORK ON -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="WORK ON THIS"
            android:textColor="@color/pc_violet_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_session_card_new"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/workOnText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Reduce filler words&#10;• Keep your pace steady&#10;• Support your second point with an example"
                android:textColor="@color/pc_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>


        <!-- XP CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_main_cta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚡"
                android:textSize="29sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+45 XP"
                    android:textColor="@color/pc_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Great job — keep practicing!"
                    android:textColor="#FFE7F4"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</ScrollView>